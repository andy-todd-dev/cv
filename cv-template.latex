\documentclass[10pt, a4paper]{article}

% ── Packages ──────────────────────────────────────────────────────────────────
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage[margin=1.8cm, top=1.5cm, bottom=1.5cm]{geometry}
\usepackage[default]{lato}        % Lato — modern sans-serif
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{parskip}
\usepackage{microtype}
\usepackage{array}
\usepackage{tabularx}
\usepackage{tcolorbox}
\tcbuselibrary{skins}

% ── Colours ───────────────────────────────────────────────────────────────────
\definecolor{headingblue}{RGB}{0, 105, 105}   % teal for section headings
\definecolor{ruleblue}{RGB}{0, 105, 105}
\definecolor{darkgray}{RGB}{60, 60, 60}

% ── Hyperlink styling ─────────────────────────────────────────────────────────
\hypersetup{
  colorlinks=true,
  urlcolor=headingblue,
  linkcolor=headingblue
}

% ── Section heading formatting ────────────────────────────────────────────────
% H2 → major sections (Skills, Experience, etc.)
\titleformat{\subsection}
  {\large\bfseries\color{headingblue}}
  {}{0em}{}
  [\color{ruleblue}\titlerule]

% H3 → job titles / subsections
\titleformat{\subsubsection}[block]
  {\normalsize\bfseries\color{darkgray}}
  {}{0em}{}[]

\titlespacing{\subsection}{0pt}{10pt}{4pt}
\titlespacing{\subsubsection}{0pt}{8pt}{2pt}

% ── List styling ──────────────────────────────────────────────────────────────
\setlist[itemize]{
  leftmargin=1.5em,
  itemsep=1pt,
  parsep=0pt,
  topsep=3pt
}

% ── Skill tag (pill) styling ──────────────────────────────────
\newtcbox{\cvtag}{%
  nobeforeafter,
  enhanced,
  arc=3pt,
  boxrule=0pt,
  top=0pt, bottom=0pt, left=4pt, right=4pt,
  colback=headingblue!12,
  colframe=headingblue!12,
  fontupper=\scriptsize\color{darkgray}
}

% ── Date styling (lighter than heading text) ─────────────────────────────────
\newcommand{\cvdate}[1]{{\small\mdseries\color{darkgray}#1}}

% ── No page numbers ───────────────────────────────────────────────────────────
\pagestyle{empty}

% ── Pandoc boilerplate (keeps tight/loose lists etc. working) ─────────────────
\providecommand{\tightlist}{%
  \setlength{\itemsep}{1pt}\setlength{\parskip}{0pt}}

% ══════════════════════════════════════════════════════════════════════════════
\begin{document}$if(name)$
\noindent\begin{tabularx}{\linewidth}{@{}X r@{}}
  {\huge\bfseries\color{headingblue} $name$} &
  \begin{tabular}[t]{@{}r@{}}
    \small $location$ \\[2pt]
    \small $phone$ \\[2pt]
    \small \href{mailto:$email$}{$email$}$if(linkedin)$ \\[2pt]
    \small \href{$linkedin$}{$if(linkedin_label)$$linkedin_label$$else$$linkedin$$endif$}$endif$$if(github)$ \\[2pt]
    \small \href{$github$}{$if(github_label)$$github_label$$else$$github$$endif$}$endif$
  \end{tabular}
\end{tabularx}
\vspace{14pt}
$endif$$body$
\end{document}
